<html>
<head>
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <script src="/js/jquery.min.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/js/swiped.min.js"></script>

  <style>
    body, html {
        margin: 0;
        padding: 0;
        font-size: 20px;
        font-family: Arial;
    }
    li {
        height: 60px;
        padding: 0 10px;
        list-style: none;
        line-height: 60px;
        color: #fff;
        margin: 0 0 2px;
    }

    ul {
        margin: 0 0 10px;
        padding: 0;
    }
    .list1 li {
        background: #f58160;
    }
    .wrapper {
        overflow: hidden;
        padding: 10px;
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <%- path %>
  </div>


  <script>
    var a1 = Swiped.init({
        query: '.list1 li',
        right: 400,
        onOpen: function() {
            this.destroy(true)
        },
        onClose: function() {
            console.log('close')
        }
    });
  </script>
</body>
</html>
